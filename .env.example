# TULOY Health - Environment Variables Template
# Copy this file to create actual .env files for each app
# NEVER commit real credentials to Git

# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from: https://supabase.com/dashboard
# Go to: Project Settings → API
# Use the SAME values for all three apps (Patient, BHW, Admin)

# For Mobile Apps (Patient & BHW)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# For Admin Web App (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️  NEVER USE service_role KEY IN CLIENT APPS
# The service_role key bypasses Row Level Security and should NEVER be in mobile/web apps

# =============================================================================
# Mapbox Configuration (BHW Mobile App Only)
# =============================================================================
# Get these from: https://account.mapbox.com/
# Go to: Access Tokens

# Public token (starts with pk.) - safe to use in mobile app
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsImEiOiJjbGJhYmNkZWYifQ...

# Secret token (starts with sk.) - used at BUILD TIME only for downloading Mapbox SDK
# Create with DOWNLOADS:READ scope
MAPBOX_DOWNLOADS_TOKEN=sk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsImEiOiJjbGJhYmNkZWYifQ...

# =============================================================================
# Where to put these variables:
# =============================================================================
# Unified Expo app (Admin + BHW + Patient, web + native): apps/mobile/.env
#   Template: apps/mobile/.env.example. For Vercel/Netlify, set the same
#   EXPO_PUBLIC_* variables in the hosting dashboard (.env is never committed).
# NEXT_PUBLIC_* vars are only for the optional future Next.js admin
#   (apps/admin/.env.local) - not used by the hackathon build.
# =============================================================================
