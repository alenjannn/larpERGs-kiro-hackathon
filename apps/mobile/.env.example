# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mapbox Configuration
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Demo map centre as "lat,lng". Synthetic DEMO patients are placed within
# 0.01 degrees of it ("approximate DEMO location") when Reset demo data runs.
# Optional; defaults to 14.5995,120.9842 (fictional Brgy. Demo San Isidro).
EXPO_PUBLIC_DEMO_MAP_CENTER=14.5995,120.9842
